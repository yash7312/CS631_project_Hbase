                 hb_explain                 
--------------------------------------------
 Foreign Scan on emp
   Filter: (id = (InitPlan 1).col1)
   HBase Table: emp
   HBase Key Cond: (id = (InitPlan 1).col1)
   HBase RPCs: 0
     ->  Result
(6 rows)

-- volatile values are not pushed down
EXPLAIN (COSTS OFF) SELECT id FROM emp WHERE id = 'e00000' || (random() * 0 + 5)::int;
                                                      QUERY PLAN                                                      
----------------------------------------------------------------------------------------------------------------------
 Foreign Scan on emp
   Filter: (id = ('e00000'::text || ((((random() * '0'::double precision) + '5'::double precision))::integer)::text))
   HBase Table: emp
(3 rows)

-- <> on the key: HBase can't skip anything, stays local
EXPLAIN (COSTS OFF) SELECT id FROM emp WHERE id <> 'e000001';
            QUERY PLAN             
-----------------------------------
 Foreign Scan on emp
   Filter: (id <> 'e000001'::text)
   HBase Table: emp
(3 rows)

