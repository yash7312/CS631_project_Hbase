-- 0xff has no successor: a\xff% stops at b, \xff% has no stop row
CREATE FOREIGN TABLE bkey (k bytea OPTIONS (rowkey 'true'),
  n int OPTIONS (column 'd:n')) SERVER hb;
SELECT * FROM bkey;
    k     | n  
----------+----
 \x61     |  1
 \x6100   |  2
 \x61feff |  3
 \x61ff   |  4
 \x61ff00 |  5
 \x61ffff |  6
 \x62     |  7
 \xff     |  8
 \xff01   |  9
 \xffff   | 10
(10 rows)

