-- values known only at run time: prepared statement, init plan
SET plan_cache_mode = force_generic_plan;
PREPARE byid(text) AS SELECT id, name FROM emp WHERE id = $1;
EXPLAIN (COSTS OFF) EXECUTE byid('e000007');
         QUERY PLAN          
-----------------------------
 Foreign Scan on emp
   Filter: (id = $1)
   HBase Table: emp
   HBase Key Cond: (id = $1)
(4 rows)

EXECUTE byid('e000007');
   id    |  name  
---------+--------
 e000007 | isha_7
(1 row)

EXECUTE byid('e000123');
   id    |   name    
---------+-----------
 e000123 | meera_123
(1 row)

EXECUTE byid(NULL);
 id | name 
----+------
(0 rows)

EXECUTE byid('');
 id | name 
----+------
(0 rows)

DEALLOCATE byid;
RESET plan_cache_mode;
SELECT hb_explain($$SELECT id FROM emp WHERE id = (SELECT 'e00000' || '9')$$);
                 hb_explain                 
--------------------------------------------
 Foreign Scan on emp
   Filter: (id = (InitPlan 1).col1)
   HBase Table: emp
   HBase Key Cond: (id = (InitPlan 1).col1)
   HBase Get Keys: 1
   HBase RPCs: 1
     ->  Result
(7 rows)

-- NULL key: no row can match, HBase is not contacted (0 RPCs)
