                                   hb_explain                                    
---------------------------------------------------------------------------------
 Foreign Scan on emp
   Filter: (id = ANY ('{e000003,e000001,nope,e000003,NULL,""}'::text[]))
   HBase Table: emp
   HBase Key Cond: (id = ANY ('{e000003,e000001,nope,e000003,NULL,""}'::text[]))
   HBase Get Keys: 3
   HBase RPCs: 1
(6 rows)

