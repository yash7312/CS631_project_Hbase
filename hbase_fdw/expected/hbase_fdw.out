  UNION ALL
  (SELECT o.oid, e.* FROM ord o LEFT JOIN emp_local e ON e.id = o.emp_id EXCEPT
   SELECT o.oid, e.* FROM ord o LEFT JOIN emp e ON e.id = o.emp_id)) x;
 mismatches 
