-- 10000 outer rows: one full scan into a hash join beats 10000 gets
EXPLAIN (COSTS OFF) SELECT count(*) FROM emp_local l JOIN emp e ON e.id = l.id;
                QUERY PLAN                 
-------------------------------------------
 Aggregate
   ->  Hash Join
         Hash Cond: (e.id = l.id)
         ->  Foreign Scan on emp e
               HBase Table: emp
         ->  Hash
               ->  Seq Scan on emp_local l
(7 rows)

